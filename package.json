{
  "name": "spent",
  "version": "1.0.0",
  "packageManager": "pnpm@10.26.0",
  "private": true,
  "scripts": {
    "deploy": "node scripts/deploy.js",
    "dev": "concurrently -p none \"serwist build --watch\" \"next dev -H 127.0.0.1 -p 3000\"",
    "build": "next build && serwist build",
    "start": "next start -H 0.0.0.0 -p 41234",
    "lint": "eslint",
    "security:audit": "pnpm audit --prod",
    "security:outdated": "pnpm outdated",
    "docs:screenshots": "node scripts/capture-docs-screenshots.mjs",
    "setup": "node scripts/setup.mjs",
    "uninstall": "node scripts/uninstall.mjs",
    "service:install": "node scripts/service/install.mjs install",
    "service:uninstall": "node scripts/service/install.mjs uninstall",
    "service:start": "node scripts/service/install.mjs start",
    "service:stop": "node scripts/service/install.mjs stop",
    "service:reload": "pnpm run build && node scripts/service/install.mjs stop && node scripts/service/install.mjs start",
    "service:status": "node scripts/service/install.mjs status",
    "service:logs": "node scripts/service/install.mjs logs",
    "service:open": "node scripts/service/install.mjs open",
    "menubar:build": "bash menubar/mac/build.sh",
    "menubar:install:mac": "bash menubar/mac/build.sh && cp -R menubar/mac/build/Spent.app ~/Applications/",
    "menubar:build:windows": "powershell -ExecutionPolicy Bypass -File menubar/windows/build.ps1",
    "menubar:install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& './menubar/windows/build.ps1'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $d = Join-Path $env:LOCALAPPDATA 'Programs\\Spent'; New-Item -ItemType Directory -Force -Path $d | Out-Null; Copy-Item -Force 'menubar/windows/build/Spent.exe' (Join-Path $d 'Spent.exe')\"",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.95.2",
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.15.0",
    "@serwist/next": "^9.5.12",
    "@serwist/turbopack": "^9.5.12",
    "@tanstack/react-query": "^5.101.4",
    "better-sqlite3": "12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "israeli-bank-scrapers": "^6.9.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.11",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "patch-package": "8.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@serwist/cli": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "node-ssh": "^13.2.1",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "pnpm.approvedBuilds": [
    "better-sqlite3",
    "esbuild",
    "patch-package",
    "sharp",
    "@next/swc-linux-x64-gnu",
    "@next/swc-linux-arm64-gnu"
  ],
  "pnpm.overrides": {
    "postcss": "^8.5.18",
    "brace-expansion": "^5.0.9",
    "sharp": "^0.35.0"
  }
}
